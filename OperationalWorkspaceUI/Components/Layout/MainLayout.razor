@inherits LayoutComponentBase
@using OperationalWorkspaceUI.UIState
@using OperationalWorkspaceUI.Components.Shared
@using Microsoft.Extensions.Configuration
@inject UIStateContainer StateContainer
@inject IConfiguration Config
@implements IDisposable

@if (!_appReady)
{
    <!-- SEQUENCE 1: SENIOR ENGINEER BLUEPRINT INITIAL LOADING SCREEN FRAME -->
    <div class="login-canvas-container d-flex flex-column align-items-center justify-content-center">
        <FluentProgressRing></FluentProgressRing>
        <span class="text-caption mt-2">Initializing Secure Enterprise Shell...</span>
    </div>
}
else if (!StateContainer.IsAuthenticated)
{
    <!-- SEQUENCE 2: CLEAN STANDALONE LOGIN GATEWAY PANE (No outer rails or sidebars present) -->
    <div class="login-canvas-container"  aria-label="Sage X3 Secure Gateway Entry">
        @Body
    </div>
}
else
{
    <!-- SEQUENCE 3: VERIFIED WORKSPACE MULTI-PANEL SPLIT COCKPIT WINDOW VIEW -->
    <div class="workspace-container-frame">
        
        <!-- Persistent Top Header Platform Banner Layout Anchor (Locked Post-Auth) -->
        <WorkspaceTopbar />

        <!-- CORE CONTENT INTERFACE SYSTEM PLATFORM -->
        <div class="workspace-inner-platform">
            
            <!-- Left Axis Column Navigation Sidebar Rail Container (Locked Post-Auth) -->
            <NavigationSidebar />

            <!-- Right Core Functional Presentation Workspace Canvas Stream -->
            <div class="d-flex flex-column flex-grow-1 min-w-0">
                
                <!-- Secondary Contextual Insights Row Component Wrapper Container -->
                <CustomerContextHost />

                <!-- Dynamic Viewport Area Node Cell (ONLY this section re-routes sub-pages) -->
                <main class="workspace-scroll-viewport" role="main">
                    @Body
                </main>
                
            </div>

        </div>

    </div>
}

@code {
    private bool _appReady = false;

    protected override async Task OnInitializedAsync()
    {
        // STABILIZATION REFACTOR: Subscribe strictly to targeted authorization events to kill render loops
        StateContainer.AuthenticationChanged += SynchronizeCoreLayoutStateView;

        // Execute unified structural configuration checks safely on boot time
        await ProcessStartupConfigurationCheck();
    }

    private async Task ProcessStartupConfigurationCheck()
    {
        try
        {
            // Extract local appsettings development configuration toggle primitives
            bool useMocks = Config.GetValue<bool>("SageX3Settings:UseMocks");
            bool useMockAuth = Config.GetValue<bool>("SageX3Settings:UseMockAuth");

            if (useMocks || useMockAuth)
            {
                // Instant configuration seed bypass if local testing is active
                StateContainer.UpdateSession(
                    isAuthenticated: true,
                    senderEmail: "finance.manager@acmecorp.com",
                    senderName: "Jane Smith",
                    activeUserEmail: "admin.manager@yourcompany.com",
                    roleScope: "Admin;Finance;Sales;Consultant",
                    response: null
                );
            }
        }
        catch
        {
            // Fail silent fallback guarantees production stability remains fully intact
        }
        finally
        {
            // Drop loading protection barriers natively
            _appReady = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SynchronizeCoreLayoutStateView()
    {
        // Safe cross-thread invocation forcing UI layout pass recalculations
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Safe lifestyle unsubscription completely prevents lingering memory leaks
        StateContainer.AuthenticationChanged -= SynchronizeCoreLayoutStateView;
    }
}
