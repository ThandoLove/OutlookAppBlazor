@inherits LayoutComponentBase
@using OperationalWorkspaceUI.UIState
@using OperationalWorkspaceUI.Components.Shared
@using Microsoft.Extensions.Configuration
@inject UIStateContainer StateContainer
@inject IConfiguration Config
@implements IDisposable

@{
    // AUDIT CHECK: Safely extract environment mock toggle flags straight from the appsettings tree
    bool useMocks = Config.GetValue<bool>("SageX3Settings:UseMocks");
    bool useMockAuth = Config.GetValue<bool>("SageX3Settings:UseMockAuth");
    
    // The workspace shell unlocks if the user completes SSO login OR if local developer mock mode is active
    bool allowWorkspaceAccess = StateContainer.IsAuthenticated || useMocks || useMockAuth;
}

@if (!allowWorkspaceAccess)
{
    <!-- SEQUENCE 1: CLEAN STANDALONE LOGIN GATEWAY LAYER (No sidebars or banners allowed) -->
    <div class="login-canvas-container">
        @Body
    </div>
}
else
{
    <!-- SEQUENCE 2: PRODUCTION BLUEPRINT MULTI-PANEL SPLIT COCKPIT WINDOW VIEW -->
    <div class="workspace-container-frame">
        
        
        <WorkspaceTopbar />

        <!-- CORE CONTENT MATRIX GRID PLATFORM -->
        <div class="workspace-inner-platform">
            
            <!-- Left Axis Column Navigation Sidebar (Constant layout shell rail) -->
            <NavigationSidebar />

            <!-- Right Core Functional Presentation Workspace Area -->
            <div class="d-flex flex-column flex-grow-1 min-w-0">
                
                <!-- Conditional External Email Sender Context Hub Component -->
                <CustomerContextHost />

                <!-- Dynamic Sub-Page Viewport Canvas Cell (Only this area swaps page documents dynamically) -->
                <main class="workspace-scroll-viewport" role="main">
                    @Body
                </main>
                
            </div>

        </div>

    </div>
}

@code {
    protected override void OnInitialized()
    {
        // Subscribe to global UI state container mutations to force responsive layout refreshes
        StateContainer.OnStateChanged += SynchronizeCoreLayoutStateView;
    }

    private void SynchronizeCoreLayoutStateView()
    {
        // Safe cross-thread invocation forcing UI thread synchronization
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Safe lifecycle unsubscription completely prevents background memory leak connections
        StateContainer.OnStateChanged -= SynchronizeCoreLayoutStateView;
    }
}
