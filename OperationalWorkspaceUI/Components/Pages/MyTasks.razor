@page "/my-tasks"
@using OperationalWorkspaceUI.UIState
@inject UIStateContainer StateContainer

<div class="my-tasks-panel p-0">
    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
        <h6 class="m-0 fw-bold text-muted text-caption" style="font-size: 0.68rem; font-weight: 700;">👤 MY ASSIGNED WORKLOAD</h6>
    </div>

    <!-- Fluent Tabs Layout Replaces Legacy Tab Button Switches -->
    <FluentTabs ActiveTabId="@_activeTab" OnTabChange="HandleTabSwitch" Size="TabSize.Small">
        
        <FluentTab Id="PENDING" Label="Active (4)">
            <div class="d-flex flex-column gap-2 mt-2">
                <FluentCard MinimalStyle="true" Style="padding: 10px; background-color: white; border: 1px solid var(--fluent-border);">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-semibold text-dark" style="font-size: 0.72rem;">Follow up with Tech Innovations Inc. regarding Quote</span>
                        <FluentBadge Appearance="Appearance.Neutral" style="font-size: 0.58rem; background-color: var(--fluent-warning); color: black;">Medium</FluentBadge>
                    </div>
                    <small class="text-muted mt-1 d-block" style="font-size: 0.65rem;">Due: Tomorrow | Context: Quote request for 50 units of product ABC.</small>
                    <div class="d-flex justify-content-end mt-2">
                        <FluentButton Appearance="Appearance.Outline" Size="ControlSize.Small" style="font-size: 0.62rem; font-weight: 600;" @onclick="MarkTaskComplete">
                            Complete Check
                        </FluentButton>
                    </div>
                </FluentCard>
            </div>
        </FluentTab>

        <FluentTab Id="OVERDUE" Label="Overdue (1)">
            <div class="d-flex flex-column gap-2 mt-2">
                <FluentCard MinimalStyle="true" Style="padding: 10px; background-color: white; border: 1px solid var(--fluent-error);">
                    <div class="d-flex justify-content-between align-items-start">
                        <span class="fw-bold" style="font-size: 0.72rem; color: var(--fluent-error);">Verify Tech Innovations Credit Exposure clearance buffers</span>
                        <FluentBadge Appearance="Appearance.Filled" style="font-size: 0.58rem; background-color: var(--fluent-error); color: white;">High</FluentBadge>
                    </div>
                    <small class="text-muted mt-1 d-block" style="font-size: 0.65rem;">Expired: 2 Days Ago | Context: Overdue balance due currently stands at $12,500.</small>
                </FluentCard>
            </div>
        </FluentTab>

        <FluentTab Id="COMPLETED" Label="Completed">
            <div class="mt-3 text-center text-muted py-3 small bg-white border rounded shadow-xs" style="border-style: dashed !important; border-color: var(--fluent-border) !important;">
                <div>Type Check: No completed task history records logged inside current thread.</div>
            </div>
        </FluentTab>

    </FluentTabs>
</div>

@code {
    private string _activeTab = "PENDING";

    private void HandleTabSwitch(FluentTab activeTab)
    {
        if (activeTab != null)
        {
            _activeTab = activeTab.Id;
        }
    }

    private void MarkTaskComplete()
    {
        _activeTab = "COMPLETED";
    }
}
