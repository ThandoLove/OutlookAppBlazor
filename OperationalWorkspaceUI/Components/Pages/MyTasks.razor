@page "/my-tasks"
@using OperationalWorkspaceUI.UIState
@inject UIStateContainer StateContainer

<div class="my-tasks-panel p-0">
    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-1">
        <h6 class="m-0 fw-bold text-caption">👤 MY ASSIGNED WORKLOAD</h6>
    </div>

    <!-- Fluent Tabs Layout Replaces Legacy Tab Button Switches -->
    <FluentTabs ActiveTabId="@_activeTab" OnTabChange="HandleTabSwitch" Size="TabSize.Small">

        <FluentTab Id="PENDING" Label="Active (4)">
            <div class="d-flex flex-column gap-2 mt-2">
                <FluentCard MinimalStyle="true" class="dashboard-fluent-card">
                    <div class="card-inner-frame">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="fw-semibold text-dark text-small">Follow up with Tech Innovations Inc. regarding Quote</span>
                            <FluentBadge Appearance="Appearance.Neutral" class="text-caption">Medium</FluentBadge>
                        </div>
                        <small class="text-muted mt-1 d-block text-caption">Due: Tomorrow | Context: Quote request for 50 units of product ABC.</small>
                        <div class="d-flex justify-content-end mt-2">
                            <FluentButton Appearance="Appearance.Stealth" Size="ControlSize.Small" class="text-small font-weight-bold" @onclick="MarkTaskComplete">
                                Complete Check
                            </FluentButton>
                        </div>
                    </div>
                </FluentCard>
            </div>
        </FluentTab>

        <FluentTab Id="OVERDUE" Label="Overdue (1)">
            <div class="d-flex flex-column gap-2 mt-2">
                <FluentCard MinimalStyle="true" class="dashboard-fluent-card border-danger">
                    <div class="card-inner-frame">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="fw-bold text-small text-danger">Verify Tech Innovations Credit Exposure clearance buffers</span>
                            <FluentBadge Appearance="Appearance.Accent" class="badge-overdue-alert text-caption">High</FluentBadge>
                        </div>
                        <small class="text-muted mt-1 d-block text-caption">Expired: 2 Days Ago | Context: Overdue balance due currently stands at $12,500.</small>
                    </div>
                </FluentCard>
            </div>
        </FluentTab>

        <FluentTab Id="COMPLETED" Label="Completed">
            <div class="mt-3 text-center text-muted py-3 border rounded read-only-ledger-preview border-bottom-dashed border-top-dashed">
                <div class="text-small">Type Check: No completed task history records logged inside current thread.</div>
            </div>
        </FluentTab>

    </FluentTabs>
</div>
@code {
    private string _activeTab = "PENDING";

    private void HandleTabSwitch(FluentTab activeTab)
    {
        if (activeTab != null)
        {
            // FIX: Using the null-coalescing fallback protects the string assignment and completely satisfies C# static analyzer rules
            _activeTab = activeTab.Id ?? "PENDING";
        }
    }

    private void MarkTaskComplete()
    {
        _activeTab = "COMPLETED";
    }
}
