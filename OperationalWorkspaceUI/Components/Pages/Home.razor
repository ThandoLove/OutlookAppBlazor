@page "/"
@layout OperationalWorkspaceUI.Components.Layout.LoginLayout
@using OperationalWorkspaceUI.UIState
@using Microsoft.Extensions.Configuration
@inject UIStateContainer StateContainer
@inject NavigationManager Nav
@inject IConfiguration Config

<div class="d-flex flex-column align-items-center w-100" style="max-width: 340px; font-family: 'Segoe UI', sans-serif;">
    <FluentCard Style="padding: 24px; text-align: center; background-color: white; border: 1px solid #edebe9;">
        <div class="mb-2" style="font-size: 2.2rem;">🔒</div>
        <h4 class="fw-bold mb-1" style="font-size: 1.1rem; color: #212529;">Sage X3 Workspace</h4>
        <p class="text-muted mb-4" style="font-size: 0.72rem; line-height: 1.45;">Please log in using your corporate credentials to verify role permissions and module flags.</p>

        @if (!string.IsNullOrEmpty(_authMessage))
        {
            <div class="mb-3">
                <FluentMessageBar Intent="@MessageIntent.Warning" AllowDismiss="true">@_authMessage</FluentMessageBar>
            </div>
        }

        <div class="mt-2">
            <FluentButton Appearance="Appearance.Accent" Style="width: 100%; font-weight: 600;" @onclick="ProcessSecureSsoAuthorization">
                Sign In via Sage X3 SSO
            </FluentButton>
        </div>
    </FluentCard>
</div>

@code {
    private string _authMessage = string.Empty;

    private async Task ProcessSecureSsoAuthorization()
    {
        _authMessage = "Connecting to identity broker service...";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(100);

        bool useMocks = Config.GetValue<bool>("SageX3Settings:UseMocks");
        bool useMockAuth = Config.GetValue<bool>("SageX3Settings:UseMockAuth");

        if (useMocks || useMockAuth)
        {
            // Seed a full comprehensive mock administrator and employee scope payload configuration
            StateContainer.UpdateSession(
                isAuthenticated: true,
                senderEmail: "finance.manager@acmecorp.com",
                senderName: "Jane Smith",
                activeUserEmail: "admin.manager@yourcompany.com",
                roleScope: "Admin;Finance;Sales;Consultant",
                response: null
            );

            // FIX: Force a micro-second asynchronous yield thread break to let MainLayout parse the new session variables
            await Task.Yield();

            // Execute clean target workspace routing switches based on assigned corporate clearance flags
            RedirectUserByAssignedRoleContext();
        }
        else
        {
            _authMessage = "Initializing secure enterprise handshake proxy...";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RedirectUserByAssignedRoleContext()
    {
        var currentQuery = Nav.ToAbsoluteUri(Nav.Uri).Query;

        // ADMIN ENVIRONMENT TOGGLE DIRECTIVE: Routes context monitors cleanly to the administrative task board
        if (!string.IsNullOrEmpty(StateContainer.UserRoleScope) && StateContainer.UserRoleScope.Contains("Admin"))
        {
            Nav.NavigateTo($"/admin-tasks{currentQuery}");
        }
        else
        {
            // STANDARD EMPLOYEE DIRECTIVE: Routes regular sales or field reps straight to their assigned checklists
            Nav.NavigateTo($"/my-tasks{currentQuery}");
        }
    }
}
