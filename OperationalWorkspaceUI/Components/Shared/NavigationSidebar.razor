@inject NavigationManager Nav

<aside class="sidebar-rail-pane" role="navigation" aria-label="Outlook Sidebar Navigation">
    <div class="d-flex flex-column gap-3 w-100 align-items-center">

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("dashboard")' title="Dashboard Cockpit">
            <div class="fs-5 mb-0.5">🏠</div>
            <span class="nav-sidebar-label text-uppercase d-block">Dash</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("contacts")' title="Contacts Directory">
            <div class="fs-5 mb-0.5">👤</div>
            <span class="nav-sidebar-label text-uppercase d-block">Contacts</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("tickets")' title="Support Cases">
            <div class="fs-5 mb-0.5">📋</div>
            <span class="nav-sidebar-label text-uppercase d-block">Cases</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("documents")' title="Attach Documents Ledger">
            <div class="fs-5 mb-0.5">📎</div>
            <span class="nav-sidebar-label text-uppercase d-block">Attach</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("knowledge")' title="Knowledge Base Documentation">
            <div class="fs-5 mb-0.5">📚</div>
            <span class="nav-sidebar-label text-uppercase d-block">Docs</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("quotes")' title="Quotes Reference">
            <div class="fs-5 mb-0.5">📑</div>
            <span class="nav-sidebar-label text-uppercase d-block">Quotes</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("admin-tasks")' title="Create Task (Admin)">
            <div class="fs-5 mb-0.5">⚙️</div>
            <span class="nav-sidebar-label text-uppercase d-block">Admin</span>
        </button>

        <button class="w-100 p-1 border-0 bg-transparent text-center cursor-pointer sidebar-nav-action-btn" type="button" @onclick='() => NavigateTo("my-tasks")' title="My Assigned Tasks">
            <div class="fs-5 mb-0.5">✅</div>
            <span class="nav-sidebar-label text-uppercase d-block">Tasks</span>
        </button>

    </div>
</aside>

<style>
    .sidebar-nav-action-btn {
        color: #a19f9d;
        transition: color 0.1s;
    }

        .sidebar-nav-action-btn:hover {
            color: #ffffff;
        }

    .nav-sidebar-label {
        font-size: 0.55rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }
</style>

@code {
    private void NavigateTo(string destination)
    {
        var currentQuery = Nav.ToAbsoluteUri(Nav.Uri).Query;
        Nav.NavigateTo($"/{destination}{currentQuery}");
    }
}
