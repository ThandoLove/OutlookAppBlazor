@using OperationalWorkspaceUI.UIState
@inject UIStateContainer StateContainer
@inject NavigationManager Nav
@implements IDisposable

@if (StateContainer.IsAuthenticated)
{
    <aside class="sidebar-rail-pane" role="navigation" aria-label="Outlook Sidebar Navigation">
        <div class="d-flex flex-column gap-3 w-100 align-items-center">

            <!-- Dynamic Active Styling Navigation Buttons Matrix -->
            <button class="@GetActiveNavClass("dashboard")" type="button" @onclick='() => NavigateTo("dashboard")' title="Dashboard Cockpit">
                <div class="fs-5 mb-0.5">🏠</div>
                <span class="nav-sidebar-label text-uppercase d-block">Dash</span>
            </button>

            <button class="@GetActiveNavClass("contacts")" type="button" @onclick='() => NavigateTo("contacts")' title="Contacts Directory">
                <div class="fs-5 mb-0.5">👤</div>
                <span class="nav-sidebar-label text-uppercase d-block">Contacts</span>
            </button>

            <button class="@GetActiveNavClass("tickets")" type="button" @onclick='() => NavigateTo("tickets")' title="Support Cases">
                <div class="fs-5 mb-0.5">📋</div>
                <span class="nav-sidebar-label text-uppercase d-block">Cases</span>
            </button>
            <button class="@GetActiveNavClass("documents")" type="button" @onclick='() => NavigateTo("documents")' title="Attach Documents Ledger">
                <div class="fs-5 mb-0.5">📎</div>
                <span class="nav-sidebar-label text-uppercase d-block">Attach</span>
            </button>

            <button class="@GetActiveNavClass("knowledge")" type="button" @onclick='() => NavigateTo("knowledge")' title="Knowledge Base Documentation">
                <div class="fs-5 mb-0.5">📚</div>
                <span class="nav-sidebar-label text-uppercase d-block">Docs</span>
            </button>

            <button class="@GetActiveNavClass("quotes")" type="button" @onclick='() => NavigateTo("quotes")' title="Quotes Reference">
                <div class="fs-5 mb-0.5">📑</div>
                <span class="nav-sidebar-label text-uppercase d-block">Quotes</span>
            </button>

            @if (!string.IsNullOrEmpty(StateContainer.UserRoleScope) && StateContainer.UserRoleScope.Contains("Admin"))
            {
                <button class="@GetActiveNavClass("admin-tasks")" type="button" @onclick='() => NavigateTo("admin-tasks")' title="Create Task (Admin)">
                    <div class="fs-5 mb-0.5">⚙️</div>
                    <span class="nav-sidebar-label text-uppercase d-block">Admin</span>
                </button>
            }

            <button class="@GetActiveNavClass("my-tasks")" type="button" @onclick='() => NavigateTo("my-tasks")' title="My Assigned Tasks">
                <div class="fs-5 mb-0.5">✅</div>
                <span class="nav-sidebar-label text-uppercase d-block">Tasks</span>
            </button>

        </div>
    </aside>
}
<style>
    /* Scope Isolation Optimization Rules */
    .sidebar-nav-action-btn {
        color: #a19f9d;
        background: transparent;
        border: none;
        cursor: pointer;
        width: 100%;
        padding: 4px 0;
        transition: color 0.1s ease-in-out, background-color 0.1s ease-in-out;
    }

        .sidebar-nav-action-btn:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.05);
        }

    .sidebar-nav-action-btn-active {
        color: var(--sage-primary, #0078d4) !important;
        background-color: rgba(255, 255, 255, 0.08);
        border-left: 2px solid var(--sage-primary, #0078d4) !important;
        font-weight: 700;
    }

    .nav-sidebar-label {
        font-size: 0.55rem;
        font-weight: 600;
        letter-spacing: 0.2px;
    }
</style>
@code {
    protected override void OnInitialized()
    {
        StateContainer.AuthenticationChanged += RefreshSidebarLayoutView;
        StateContainer.ActiveUserChanged += RefreshSidebarLayoutView;
    }

    private void RefreshSidebarLayoutView()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetActiveNavClass(string targetPageSegment)
    {
        var activeRoute = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        bool isRouteMatching = activeRoute.Equals(targetPageSegment, StringComparison.OrdinalIgnoreCase);

        return isRouteMatching
            ? "sidebar-nav-action-btn sidebar-nav-action-btn-active"
            : "sidebar-nav-action-btn";
    }

    private void NavigateTo(string destination)
    {
        var currentQuery = Nav.ToAbsoluteUri(Nav.Uri).Query;
        Nav.NavigateTo($"/{destination}{currentQuery}");
    }

    public void Dispose()
    {
        StateContainer.AuthenticationChanged -= RefreshSidebarLayoutView;
        StateContainer.ActiveUserChanged -= RefreshSidebarLayoutView;
    }
}
