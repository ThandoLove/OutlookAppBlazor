@using OperationalWorkspaceUI.UIState
@inject UIStateContainer StateContainer

<div class="workspace-top-banner">

    <!-- Left Section Brand Plate -->
    <div class="d-flex align-items-center gap-2">
        <span class="fw-bold text-dark text-small" style="letter-spacing: -0.1px;">Sage X3 Workspace</span>
        <FluentBadge Appearance="Appearance.Neutral" class="status-blink-node text-caption px-1.5 py-0.5 text-white" style="background-color: var(--sage-alert-success); border-radius: 4px;">
            ● Connected
        </FluentBadge>
    </div>

    
    <div class="d-flex align-items-center gap-2">
        <div class="text-end lh-1">
            <div class="fw-bold text-dark" style="font-size: 0.72rem;">John Smith</div>
            <small class="text-muted d-block text-caption">Sales Rep</small>
        </div>
        <FluentPersona Initials="JS" Presence="PresenceStatus.Available" PresenceSize="PresenceBadgeSize.Small" />
    </div>

</div>
