@using OperationalWorkspaceUI.UIState
@inject UIStateContainer StateContainer

<div class="w-100 bg-white border-bottom px-2 py-1.5 d-flex justify-content-between align-items-center position-relative shadow-xs top-bar-height">

    <!-- Application Brand Title Plate -->
    <div class="d-flex align-items-center gap-2">
        <span class="fw-bold text-dark" style="font-size: 0.82rem; letter-spacing: -0.1px;">Sage X3 Workspace</span>
        <FluentBadge Appearance="@(StateContainer.IsAuthenticated ? Appearance.Filled : Appearance.Neutral)"
                     class="status-blink-node"
                     style="@(StateContainer.IsAuthenticated ? "background-color: var(--sage-alert-success); color: white;" : "background-color: var(--sage-alert-danger); color: white;")">
            @(StateContainer.IsAuthenticated ? "● Connected" : "○ Offline")
        </FluentBadge>
    </div>

    <!-- Active Profile Info -->
    <div class="d-flex align-items-center gap-2">
        <div class="text-end lh-1">
            <div class="fw-bold text-dark" style="font-size: 0.75rem;">John Smith</div>
            <small class="text-muted d-block" style="font-size: 0.62rem;">Sales Rep</small>
        </div>
        <FluentPersona Initials="JS"
                       Presence="@(StateContainer.IsAuthenticated ? PresenceStatus.Available : PresenceStatus.Offline)"
                       PresenceSize="PresenceBadgeSize.Small" />
    </div>
</div>

<!-- FIX: Added absolute layer tracking to completely isolate unauthorized users -->
@if (!StateContainer.IsAuthenticated)
{
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(32, 31, 30, 0.75); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
        <FluentCard Style="width: 320px; padding: 20px; text-align: center; background-color: white;">
            <div class="mb-2" style="font-size: 2.5rem;">🛑</div>
            <h5 class="fw-bold text-danger mb-1" style="font-size: 0.95rem;">Access Authorization Revoked</h5>
            <p class="text-muted small mb-3" style="font-size: 0.75rem; line-height: 1.4;">Your local machine context profile or active security credentials do not belong to an authorized Sage X3 corporate user registry configuration.</p>
            <FluentMessageBar Intent="@MessageIntent.Error" AllowDismiss="false">
                Operational Workspace Disabled.
            </FluentMessageBar>
        </FluentCard>
    </div>
}
